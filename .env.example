# Copy the values you need into your shell or cluster job environment.
export VENV_DIR="/path/to/venv"
export MODEL_ID="unsloth/gpt-oss-120b-unsloth-bnb-4bit"
export DATASET="$(pwd)/toy.jsonl"
export OUT_DIR="$(pwd)/runs/gptoss120b-lora"
export MERGED_OUT="$(pwd)/runs/gptoss120b-merged"

export MAX_SEQ_LEN=2048
export BSZ=1
export GA=16
export LR=2e-4
export MAX_STEPS=200
export SAVE_STEPS=200
export LOG_STEPS=5

export LORA_R=16
export LORA_ALPHA=16
export LORA_DROPOUT=0
